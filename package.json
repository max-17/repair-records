{
  "name": "shop-and-repairs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/check-db-bundle.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:telegram": "tsx --conditions=react-server --test scripts/telegram.test.ts scripts/telegram-photo.test.ts",
    "check:db-bundle": "node scripts/check-db-bundle.mjs",
    "test:auth": "tsx --tsconfig tsconfig.json --conditions=react-server --test scripts/auth.test.ts",
    "test": "node --test test/*.test.js",
    "repair:start": "node src/server.js",
    "db:setup": "node scripts/setup.js",
    "telegram:commands": "node scripts/telegram-commands.js",
    "telegram:setup": "node scripts/telegram-webhook.js",
    "eval": "node scripts/eval.js",
    "speech:try": "node scripts/speech-try.js",
    "db:setup:local": "node scripts/setup-local.js",
    "test:products": "tsx --conditions=react-server --test scripts/product-fields.test.ts scripts/image-cleanup.test.ts scripts/product-variants.test.ts scripts/category-fields.test.ts",
    "customer:setup": "node scripts/customer-webhook.js",
    "test:customer": "tsx --conditions=react-server --test scripts/customer-*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/groq": "^4.0.84",
    "@base-ui/react": "^1.0.0",
    "@fontsource/manrope": "^5.2.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/postcss": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@uploadthing/react": "^7.3.3",
    "@zxing/browser": "^0.2.1",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "packageManager": "bun@1.4.4"
}
