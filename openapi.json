{
  "openapi": "3.1.0",
  "info": {
    "title": "Repair shop records",
    "version": "1.0.0",
    "description": "Manage repair records for the master associated with the API credential."
  },
  "servers": [
    {
      "url": "https://YOUR-BACKEND-DOMAIN.example"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/repairs": {
      "post": {
        "operationId": "createRepair",
        "summary": "Save a repair",
        "description": "Generate a UUID request_id once per repair. Reuse it unchanged for retries.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "customer": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "device": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "work": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "price_uzs": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Agreed total price in UZS, not payment received. Omit if unknown."
                  },
                  "due_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Calendar date resolved using Asia/Tashkent. Omit if unknown."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "received",
                      "in_progress",
                      "ready",
                      "delivered",
                      "cancelled"
                    ]
                  },
                  "request_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "request_id",
                  "customer",
                  "device",
                  "work"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "201": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "findRepairs",
        "summary": "Find up to 100 most recent repairs",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Customer or device substring"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "received",
                "in_progress",
                "ready",
                "delivered",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/repairs/{id}": {
      "patch": {
        "operationId": "updateRepair",
        "summary": "Update an identified repair",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "customer": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "device": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "work": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "price_uzs": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Agreed total price in UZS, not payment received. Omit if unknown."
                  },
                  "due_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Calendar date resolved using Asia/Tashkent. Omit if unknown."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "received",
                      "in_progress",
                      "ready",
                      "delivered",
                      "cancelled"
                    ]
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
